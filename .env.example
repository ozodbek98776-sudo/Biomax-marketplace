# ── Baza ──────────────────────────────────────────────────────────────
# ERP bilan BIR XIL PostgreSQL, lekin ALOHIDA `marketplace` sxemasi.
#
# Ish vaqti — pooler orqali. `schema=` parametri kerak emas: jadvallar
# Prisma sxemasida `@@schema("marketplace")` bilan to'liq nomlanadi.
DATABASE_URL="postgresql://mp_user:PAROL@ep-xxx-pooler.region.aws.neon.tech/baza?sslmode=require"

# Migratsiya — TO'G'RIDAN-TO'G'RI ulanish (host da `-pooler` YO'Q) va
# `schema=marketplace` BILAN (migratsiya tarixi shu sxemada saqlanadi).
# Pooler orqali migratsiya qilish ERP ni buzadi — prisma.config.ts ga qarang.
DIRECT_DATABASE_URL="postgresql://mp_user:PAROL@ep-xxx.region.aws.neon.tech/baza?sslmode=require&schema=marketplace"

# ── ERP shartnomasi ───────────────────────────────────────────────────
ERP_BASE_URL="http://localhost:3001"
# Ikkala tomonda BIR XIL bo'lishi shart. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ERP_HMAC_SECRET=""

# ── Seans ─────────────────────────────────────────────────────────────
SESSION_SECRET=""

# ── Sayt ──────────────────────────────────────────────────────────────
SAYT_URL="http://localhost:3002"

# ── Proksi ───────────────────────────────────────────────────────────
# nginx ortida "true" (nginx: proxy_set_header X-Real-IP $remote_addr;).
# Proksisiz "true" qo'yilsa IP chegarasini soxta sarlavha bilan aylanib o'tish mumkin.
PROKSI_ORQALI="true"

# ── Telegram ──────────────────────────────────────────────────────────
# Bot token — kirish kodini yuborish uchun. @BotFather dan olinadi.
# Deploydan keyin bir marta: node scripts/webhook-ornat.mjs <https manzil>
TELEGRAM_BOT_TOKEN=""
# Kirish kodi qayerga yuboriladi: "telegram" yoki "konsol".
# Lokal rivojlanishda "konsol" — kod terminalda ko'rinadi, Telegram'ga
# hech narsa ketmaydi. Ishlab chiqarishda bu qiymat E'TIBORGA OLINMAYDI.
KOD_KANALI="konsol"
